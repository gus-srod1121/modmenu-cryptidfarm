<Project>
  <PropertyGroup>
    <!-- Game path -->
    <GameDir>PATH_TO_GAME_FOLDER</GameDir>
  </PropertyGroup>

  <!-- Auto-copy DLL to game's mod folder -->
  <Target Name="Copy Mod Files" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(GameDir)\Mods" />
  </Target>
</Project>
